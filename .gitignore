# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. Never use .env* for secrets here: OpenNext bundles them into the Worker.
.env*
.dev.vars*
!.dev.vars.example

# cloudflare
.open-next
.wrangler

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pre-Cloudflare local data (SQLite + videos)
/data
