# Users bring their own provider keys (ArgoLink / ModelArk) in the app's
# Settings, so no provider keys are configured here.

# Encrypts users' stored API keys. Generate with: openssl rand -base64 32
# Changing it makes every saved key unreadable (users would re-enter them).
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Web application). Authorized redirect URI:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL, only needed behind a proxy or on a custom domain,
# e.g. https://studio.example.com (must match the Google redirect URI).
APP_URL=

# Cloudflare R2 for users' videos, one bucket per user (optional; without it
# videos are stored under DATA_DIR). Create an Account API token under
# R2 → Manage API tokens with "Admin Read & Write" (it creates buckets).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket names are "<prefix>-<user id>". Use a different prefix per environment.
R2_BUCKET_PREFIX=seedance
# Only for a non-default endpoint, e.g. EU jurisdiction:
#   https://<account id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# Where the database and videos live (default ./data)
DATA_DIR=
