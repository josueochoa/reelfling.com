# Which provider to use: "argolink" or "modelark".
# If unset, ArgoLink is used when ARGOLINK_API_KEY is set, otherwise ModelArk.
VIDEO_PROVIDER=

# --- ArgoLink (https://argolink.io) ---
ARGOLINK_API_KEY=

# --- BytePlus ModelArk ---
ARK_API_KEY=
# International (BytePlus): https://ark.ap-southeast.bytepluses.com/api/v3
# China (Volcengine):       https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
